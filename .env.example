# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose to the browser

# ── Mailbox (Inbox) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=              # only for single-tenant Azure apps

# ── AI Agent ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # server only; chat is disabled until set
AI_PROVIDER=anthropic               # only "anthropic" is implemented today
AI_MODEL=claude-sonnet-5            # any supported Anthropic model ID, e.g. claude-opus-5-5, claude-haiku-4-5-20251001
# Optional tuning (defaults shown)
# AI_REQUEST_TIMEOUT_MS=60000       # per attempt
# AI_MAX_RETRIES=2                  # bounded retries on 429/5xx/connection errors (max 4)
# AI_MAX_OUTPUT_TOKENS=4096
# AI_DAILY_REQUEST_LIMIT=150        # per user, resets at midnight UTC
# AI_DAILY_TOKEN_LIMIT=300000       # per user (input + output)
