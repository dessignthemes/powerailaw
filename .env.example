# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose to the browser

# ── Mailbox (Inbox) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=              # only for single-tenant Azure apps

# ── AI Agent ──────────────────────────────────────────────────────────────
# Set ONE provider key (server only; chat is disabled until one is set).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_PROVIDER=anthropic             # "anthropic" or "openai"; if unset, uses whichever key is present (Anthropic first)
# AI_MODEL=                         # default: claude-sonnet-5 (Anthropic) or gpt-5.5 (OpenAI)
# Optional tuning (defaults shown)
# AI_REQUEST_TIMEOUT_MS=60000       # per attempt
# AI_MAX_RETRIES=2                  # bounded retries on 429/5xx/connection errors (max 4)
# AI_MAX_OUTPUT_TOKENS=4096
# AI_DAILY_REQUEST_LIMIT=150        # per user, resets at midnight UTC
# AI_DAILY_TOKEN_LIMIT=300000       # per user (input + output)
